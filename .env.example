# --- API ---
PORT=4000
SESSION_SECRET=change-me-in-production
# Optional: SevaLens works fully without an API key (deterministic fallbacks).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# SQLite file (relative to apps/api)
DATABASE_PATH=data/sevalens.db
# Salt for Aadhaar hashing (dedupe). Never commit a real one.
AADHAAR_SALT=demo-salt-not-for-production
